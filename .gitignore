# Dependencies
node_modules/
backend/vendor/
frontend/node_modules/

# Environment files
.env
.env.backup
.env.production
backend/.env
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Nuxt / Vite / Frontend build artifacts
frontend/.nuxt/
frontend/.output/
frontend/.nitro/
frontend/dist/

# Laravel storage & cache
backend/storage/*.key
backend/storage/pail/
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/logs/*.log
backend/.phpunit.cache/
backend/.phpunit.result.cache

# SQLite local databases (keep schema/seeds versioned)
*.sqlite-journal

# IDE & OS files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
